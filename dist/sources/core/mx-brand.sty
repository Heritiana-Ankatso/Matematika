% mx-brand.sty -- the look of the PDFs and Beamer lectures: design v7 "Pavage" (docs/DESIGN_V7.md).
% This is the only file of the TeX core that belongs to one site. Every other core file is structure (what a page,
% a box or a slide holds) and reads its look from the names below; units never name a colour value or a font.
% A brand file defines, in this order:
%   colours   mxink mxinktwo mxmuted mxline mxlinestrong mxpaper; mxaccent mxaccentsoft (brand, structure);
%             mxobject mxobjectfill mxobjectsoft (studied object: lines and words, fill, pale fill); mxobjtwo
%             mxobjtwosoft (second object); mxpos mxpossoft (correct); mxneg mxnegsoft (error); mxmark mxonmark (chip
%             and highlight, text on it); mxslidebg mxslideink (title slide)
%   fonts     main, sans, mono and maths faces (fontspec, files in fonts/); \mxdisplayfont (chapter and slide titles),
%             \mxheadfont (sections, box titles), \mxlabelfont (frame and chips)
%   names     \mxbrandname (plain text, PDF metadata), \mxbrandwordmark (set), \mxbrandmark{size} (the logo),
%             \mxbrandtagline (French and English, read through \mxtr)
%   pages     \mxbrandframe (header and footer of every page; uses \mxput, \mxframepage, \mxdocumentpages)
%   headings  \mxchapterlabelstyle \mxchaptertitlestyle \mxchapterrule \mxsectionstyle \mxsectionnumber{n}
%             \mxsubsectionstyle \mxsheetsectionrule
%   boxes     \mxboxtitlefont; families result, definition, method, work, quiet, pitfall, teacher as tcolorbox styles
%             mx/<family> (each sets the title colour mx@accent); mx/chip; mx/band (dark header of sessions and tests);
%             \mxarc (corner radius)
%   slides    \mxslidetitlebackground (TikZ drawing behind the title slide), \mxslidetitlefont, \mxslideframetitlemark
% The fonts are made from the site's web fonts by scripts/tex-fonts.py (list in fonts/fonts.json).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mx-brand}[2026/11/15 Matematika brand: Pavage]
\providecommand{\mxcorepath}{}
\@ifpackageloaded{xcolor}{}{\RequirePackage[table]{xcolor}}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}

% ---- Colours (print: white paper; values of the Jour theme of the site) ----------------------------------------------
\definecolor{mxink}{HTML}{18181B}          % graphite
\definecolor{mxinktwo}{HTML}{3A3D47}
\definecolor{mxmuted}{HTML}{444854}
\definecolor{mxline}{HTML}{D6D3CB}         % hairline
\definecolor{mxlinestrong}{HTML}{5C6170}   % slate
\definecolor{mxpaper}{HTML}{F3F0E9}        % bone, lightened for print
\definecolor{mxaccent}{HTML}{2C3D8F}       % indigo: brand and structure
\definecolor{mxaccentsoft}{HTML}{E4E7F4}
\definecolor{mxobject}{HTML}{8A5A00}       % ochre ink: the studied object, lines and words
\definecolor{mxobjectfill}{HTML}{C98B1E}   % ochre: the studied object as a fill
\definecolor{mxobjectsoft}{HTML}{F4E8CF}
\definecolor{mxobjtwo}{HTML}{9E3B22}       % laterite
\definecolor{mxobjtwosoft}{HTML}{F5E4DE}
\definecolor{mxpos}{HTML}{2E6B3F}          % moss
\definecolor{mxpossoft}{HTML}{E2EFE5}
\definecolor{mxneg}{HTML}{A11D2B}          % crimson
\definecolor{mxnegsoft}{HTML}{F6E3E4}
\colorlet{mxmark}{mxobjectfill}
\colorlet{mxonmark}{mxink}
\colorlet{mxslidebg}{mxaccent}
\definecolor{mxslideink}{HTML}{FFFFFF}

% ---- Fonts -------------------------------------------------------------------------------------------------------------
% Text: Atkinson Hyperlegible (made for low vision; no italic is shipped, so it is slanted). Headings and labels:
% Archivo, expanded for titles. Mathematics: STIX Two. Code: Latin Modern Mono.
\defaultfontfeatures{Path=\mxcorepath fonts/,Ligatures=TeX}
\setmainfont{AtkinsonHyperlegible}[Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Regular,
  ItalicFeatures={FakeSlant=.16},BoldItalicFont=*-Bold,BoldItalicFeatures={FakeSlant=.16}]
\setsansfont{Archivo}[Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Regular,
  ItalicFeatures={FakeSlant=.16},BoldItalicFont=*-Bold,BoldItalicFeatures={FakeSlant=.16}]
\setmonofont{lmmono10-regular}[Extension=.otf,UprightFont=*,ItalicFont=lmmono10-italic,BoldFont=lmmonolt10-bold,
  BoldItalicFont=lmmonolt10-boldoblique,Scale=.94]
\setmathfont{STIXTwoMath-Regular}[Extension=.otf]
\newfontfamily\mxdisplayfont{ArchivoExpanded-ExtraBold}[Extension=.ttf,BoldFont=*]
\newfontfamily\mxheadfont{ArchivoSemiExpanded-ExtraBold}[Extension=.ttf,BoldFont=*]
\newfontfamily\mx@caps{Archivo-Bold}[Extension=.ttf,LetterSpace=12]
\newcommand{\mxlabelfont}{\mx@caps}

% ---- Names and mark ----------------------------------------------------------------------------------------------------
\newcommand{\mxbrandname}{Matematika}
\newcommand{\mxbrandwordmark}{{\mxdisplayfont MATEMATIKA}}
% The mark: four copies of one Truchet tile whose arcs meet in a circle at the centre. \mxbrandmark[square][arcs]{side};
% drawn on the 120-unit grid of the site's SVG (y turned up).
\newlength{\mx@u}
\NewDocumentCommand{\mxbrandmark}{O{mxaccent} O{white} m}{\setlength{\mx@u}{#3}\divide\mx@u by 120\relax
  \begin{tikzpicture}[baseline={(0,0)}]
  \fill[#1] (0,0) rectangle (120\mx@u,120\mx@u);
  \begin{scope}\clip (0,0) rectangle (120\mx@u,120\mx@u);
  \draw[#2,line width=12\mx@u] (60\mx@u,60\mx@u) circle[radius=30\mx@u]
    (30\mx@u,120\mx@u) arc[start angle=0,end angle=-90,radius=30\mx@u]
    (90\mx@u,120\mx@u) arc[start angle=180,end angle=270,radius=30\mx@u]
    (0,30\mx@u) arc[start angle=90,end angle=0,radius=30\mx@u]
    (120\mx@u,30\mx@u) arc[start angle=90,end angle=180,radius=30\mx@u];
  \end{scope}
\end{tikzpicture}}
\newcommand{\mxbrandtagline}{\mxtr{Une règle, des mondes infinis.}{One rule. Infinite worlds.}}

% ---- Page frame --------------------------------------------------------------------------------------------------------
% Header: a 4 pt graphite bar opens the page, the name in spaced capitals below it, the language at the right. Footer:
% a hairline, the tagline and the page count. Square corners, no fill, no shadow.
\newcommand{\mxbrandframe}{%
  \AtPageUpperLeft{%
    \mxput{23bp}{-22bp}{\color{mxink}\rule{\dimexpr\paperwidth-46bp\relax}{4bp}}%
    \mxput{23bp}{-31bp}{\makebox(0,0)[lb]{\mxlabelfont\fontsize{7.2bp}{9bp}\selectfont\color{mxink}MATEMATIKA}}%
    \mxput{\dimexpr\paperwidth-23bp-5.2em\relax}{-31bp}{\makebox(0,0)[lb]{\mxlabelfont\fontsize{7.2bp}{9bp}\selectfont\color{mxlinestrong}\mxtr{FR}{EN}}}}%
  \AtPageLowerLeft{%
    \mxput{23bp}{26.75bp}{\color{mxline}\rule{\dimexpr\paperwidth-46bp\relax}{.6bp}}%
    \mxput{23bp}{14bp}{\makebox(0,0)[lb]{\sffamily\fontsize{7.2bp}{9bp}\selectfont\color{mxlinestrong}\mxbrandtagline}}%
    \mxput{\dimexpr\paperwidth-23bp-3.4em\relax}{14bp}{\makebox(0,0)[lb]{\sffamily\bfseries\fontsize{7.2bp}{9bp}\selectfont\color{mxink}\mxframepage\ \textcolor{mxlinestrong}{/ \mxdocumentpages}}}}}

% ---- Headings ----------------------------------------------------------------------------------------------------------
% Sections carry the § sign; a 2 pt graphite rule closes a chapter title.
\newcommand{\mxchapterlabelstyle}{\mxlabelfont\small\color{mxlinestrong}}
\newcommand{\mxchaptertitlestyle}{\mxdisplayfont\fontsize{27}{29}\selectfont\color{mxink}}
\newcommand{\mxchapterrule}{\vspace{8pt}\noindent{\color{mxink}\rule{\linewidth}{2pt}}}
\newcommand{\mxsectionstyle}{\mxheadfont\Large\color{mxink}}
\newcommand{\mxsectionnumber}[1]{\textcolor{mxaccent}{\S#1}}
\newcommand{\mxsubsectionstyle}{\mxheadfont\large\color{mxink}}
\newcommand{\mxsheetsectionrule}{\vspace{-2pt}{\color{mxink}\titlerule[1.2pt]}}

% ---- Boxes -------------------------------------------------------------------------------------------------------------
% Square corners, structure by rules: a definition opens on a 2.5 pt graphite rule, a theorem is framed, work opens
% on a hairline, errors and teacher material carry a coloured rule on a pale fill.
\newcommand{\mxarc}{0pt}
\newcommand{\mxboxtitlefont}{\sffamily\bfseries}
\tcbset{
  mx/base/.style={enhanced,breakable,parbox=false,sharp corners,boxrule=0pt,colframe=white,colback=white,
    left=9pt,right=9pt,top=6pt,bottom=6pt,before skip=7pt,after skip=5pt,fontupper=\normalfont},
  mx/result/.style={mx/base,boxrule=1.2pt,colframe=mxink,code={\colorlet{mx@accent}{mxaccent}}},
  mx/definition/.style={mx/base,left=0pt,right=0pt,borderline north={2.5pt}{0pt}{mxink},code={\colorlet{mx@accent}{mxink}}},
  mx/method/.style={mx/base,colback=mxpaper,code={\colorlet{mx@accent}{mxink}}},
  mx/work/.style={mx/base,left=0pt,right=0pt,borderline north={.8pt}{0pt}{mxline},code={\colorlet{mx@accent}{mxink}}},
  mx/quiet/.style={mx/base,colback=mxpaper,code={\colorlet{mx@accent}{mxinktwo}}},
  mx/pitfall/.style={mx/base,colback=mxnegsoft,borderline west={2.5pt}{0pt}{mxneg},code={\colorlet{mx@accent}{mxneg}}},
  mx/teacher/.style={mx/base,colback=mxpossoft,borderline west={2.5pt}{0pt}{mxpos},code={\colorlet{mx@accent}{mxpos}}},
  mx/chip/.style={on line,colback=mxmark,colframe=mxmark,coltext=mxonmark,boxrule=0pt,sharp corners,
    left=4pt,right=4pt,top=1pt,bottom=1pt,fontupper=\mxlabelfont\scriptsize},
  mx/band/.style={enhanced,colback=mxink,colframe=mxink,boxrule=0pt,sharp corners,coltext=white},
}

% ---- Slides (Beamer theme mx) ------------------------------------------------------------------------------------------
% Title slide: an indigo page with a column of Truchet tiles at the right, two of them in ochre.
\newcommand{\mxslidetitlebackground}{\begin{tikzpicture}[remember picture,overlay]
  \fill[mxslidebg] (current page.south west) rectangle (current page.north east);
  \begin{scope}[shift={([xshift=-40mm]current page.south east)}]
  \foreach \i in {0,...,3}\foreach \j in {0,...,8}{
    \pgfmathtruncatemacro\turn{mod(\i*7+\j*3+1+mod(\i*\j,5),2)}
    \pgfmathtruncatemacro\hot{or(and(\i==1,\j==4),and(\i==2,\j==1))}
    \ifnum\hot=1\fill[mxobjectfill] (\i*10mm,\j*10mm) rectangle ++(10mm,10mm);\def\mx@arcs{mxink}\else\def\mx@arcs{mxpaper}\fi
    \begin{scope}[shift={(\i*10mm+5mm,\j*10mm+5mm)},rotate=90*\turn]
      \draw[\mx@arcs,line width=1.4mm] (0,5mm) arc[start angle=0,end angle=-90,radius=5mm]
        (0,-5mm) arc[start angle=180,end angle=90,radius=5mm];
    \end{scope}}
  \end{scope}
\end{tikzpicture}}
% Face of the title on the title slide: the semi-expanded heading face (width 112, as the h1 of the site: the expanded face is too wide for long lecture titles).
\newcommand{\mxslidetitlefont}{\mxheadfont}
% The mark before a frame title: a short indigo bar.
\newcommand{\mxslideframetitlemark}{{\color{mxaccent}\rule{1.6em}{2.6pt}}}
