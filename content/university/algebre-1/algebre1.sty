% algebre1.sty -- page design of the Algèbre 1 PDF editions (palette "Pavage": bone, graphite, indigo, ochre, laterite).
% Used by the documents that scripts/build-algebre1.py writes; FONTPATH is replaced by the folder of the STIX Two fonts.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{algebre1}[2026/11/16 Algebre 1 editions]
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\defaultfontfeatures{Path=FONTPATH,Ligatures=TeX}
\setmainfont{STIXTwoText}[Extension=.otf,UprightFont=*-Regular,ItalicFont=*-Italic,BoldFont=*-Bold,BoldItalicFont=*-BoldItalic]
\setsansfont{STIXTwoText}[Extension=.otf,UprightFont=*-SemiBold,BoldFont=*-Bold,ItalicFont=*-Italic,BoldItalicFont=*-BoldItalic,LetterSpace=2]
\setmathfont{STIXTwoMath-Regular}[Extension=.otf]
\RequirePackage[french]{babel}
\RequirePackage[a4paper,left=24mm,right=24mm,top=24mm,bottom=24mm,headheight=14pt]{geometry}
\RequirePackage[table]{xcolor}
\definecolor{a1ink}{HTML}{18181B}
\definecolor{a1muted}{HTML}{5C6170}
\definecolor{a1indigo}{HTML}{2C3D8F}
\definecolor{a1ochre}{HTML}{A06A0E}
\definecolor{a1laterite}{HTML}{9E3B22}
\definecolor{a1bone}{HTML}{F4F1EA}
\definecolor{a1indigosoft}{HTML}{EEF0F8}
\definecolor{a1line}{HTML}{D6D3CB}
\RequirePackage{titlesec,fancyhdr,enumitem,booktabs,array,needspace}
\RequirePackage[most]{tcolorbox}
\RequirePackage[hidelinks,bookmarksnumbered]{hyperref}
\setlength{\parindent}{0pt}\setlength{\parskip}{5pt plus 1pt}
\setlength{\emergencystretch}{3em}\tolerance=2000\linespread{1.07}
\setlist{itemsep=2pt,topsep=3pt}
\allowdisplaybreaks
% Headings: graphite, a 2 pt indigo rule under chapters, section numbers in ochre with a § mark.
\titleformat{\chapter}[display]{\raggedright\color{a1ink}\bfseries}{\sffamily\small\color{a1indigo}\MakeUppercase{Chapitre~\thechapter}}{6pt}{\fontsize{24}{28}\selectfont}[{\color{a1indigo}\titlerule[2pt]}]
\titleformat{name=\chapter,numberless}[display]{\raggedright\color{a1ink}\bfseries}{}{0pt}{\fontsize{24}{28}\selectfont}[{\color{a1indigo}\titlerule[2pt]}]
\titlespacing*{\chapter}{0pt}{0pt}{18pt}
\titleformat{\section}{\needspace{5\baselineskip}\Large\bfseries\color{a1ink}}{\color{a1ochre}\S\thesection}{.6em}{}
\titleformat{\subsection}{\needspace{4\baselineskip}\large\bfseries\color{a1ink}}{\color{a1ochre}\thesubsection}{.5em}{}
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{.4pt}
\fancyhead[L]{\small\sffamily\color{a1muted}MATEMATIKA \textperiodcentered{} ALGÈBRE 1}
\fancyhead[R]{\small\color{a1muted}\leftmark}
\fancyfoot[C]{\small\sffamily\thepage}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\small\sffamily\thepage}}
% Boxes: square corners, a 2.4 pt left rule; the colour says what the box is.
\colorlet{a1c-def}{a1indigo}\colorlet{a1c-thm}{a1ink}\colorlet{a1c-meth}{a1ochre}\colorlet{a1c-warn}{a1laterite}
\colorlet{a1c-key}{a1indigo}\colorlet{a1c-ex}{a1muted}\colorlet{a1c-rem}{a1muted}\colorlet{a1c-idea}{a1ochre}\colorlet{a1c-web}{a1indigo}
\colorlet{a1f-def}{a1indigosoft}\colorlet{a1f-thm}{a1bone}\colorlet{a1f-key}{a1indigosoft}\colorlet{a1f-meth}{white}\colorlet{a1f-warn}{white}
\colorlet{a1f-ex}{white}\colorlet{a1f-rem}{white}\colorlet{a1f-idea}{white}\colorlet{a1f-web}{white}
\colorlet{a1l-S}{a1indigo}\colorlet{a1l-A}{a1ochre}\colorlet{a1l-D}{a1laterite}
\newtcolorbox{a1box}[2]{enhanced,breakable,sharp corners,boxrule=0pt,frame hidden,borderline west={2.4pt}{0pt}{a1c-#1},
  colback=a1f-#1,left=9pt,right=6pt,top=4pt,bottom=5pt,before skip=8pt,after skip=6pt,parbox=false,
  before upper={\if\relax\detokenize{#2}\relax\else{\sffamily\color{a1c-#1}#2}\par\smallskip\fi}}
\newenvironment{a1proof}[1]{\par\needspace{3\baselineskip}{\sffamily\color{a1muted}#1.}\enspace}{\hfill$\square$\par\medskip}
\newcommand{\alglevel}[1]{\colorbox{a1l-#1}{\textcolor{white}{\sffamily\footnotesize #1}}}
\newtcolorbox{a1exo}[3]{enhanced,breakable,sharp corners,boxrule=0pt,frame hidden,borderline north={1pt}{0pt}{a1line},colback=white,
  left=0pt,right=0pt,top=6pt,bottom=2pt,before skip=8pt,parbox=false,before upper={\alglevel{#2}\enspace{\sffamily\color{a1ink}Exercice #1}\if\relax\detokenize{#3}\relax\else\ \textperiodcentered\ {\bfseries #3}\fi\par\smallskip}}
\newtcolorbox{a1sol}[1]{enhanced,breakable,sharp corners,boxrule=0pt,frame hidden,borderline west={1.6pt}{0pt}{a1indigo},colback=a1bone,
  left=8pt,right=6pt,top=3pt,bottom=4pt,before skip=5pt,parbox=false,before upper={{\sffamily\color{a1indigo}#1.}\enspace}}
\newtcolorbox{a1qcm}[2]{enhanced,breakable,sharp corners,boxrule=0pt,frame hidden,borderline west={1.6pt}{0pt}{a1ochre},colback=white,
  left=8pt,right=0pt,top=4pt,bottom=2pt,before skip=7pt,parbox=false,before upper={{\sffamily\color{a1ink}Question #1}\enspace{\sffamily\footnotesize\color{a1muted}(#2)}\par\smallskip}}
\newcommand{\algtitle}[1]{\begin{titlepage}\color{a1ink}\vspace*{40mm}
  {\sffamily\color{a1indigo}\large MATEMATIKA \textperiodcentered{} UNIVERSITÉ}\par\vspace{6mm}
  {\color{a1indigo}\rule{\linewidth}{2pt}}\par\vspace{8mm}
  {\fontsize{40}{44}\selectfont\bfseries Algèbre 1}\par\vspace{6mm}
  {\Large #1}\par\vspace{12mm}
  {\large\color{a1muted} Ensembles, matrices, espaces vectoriels, groupes, anneaux.\par Première année de licence.}\vfill
  {\small\color{a1muted} Textes, démonstrations, figures et exercices originaux. Version web interactive : site Matematika, rubrique Université.}
  \end{titlepage}\tableofcontents\clearpage}
